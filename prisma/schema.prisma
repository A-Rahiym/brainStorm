generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  HEADMASTER
  TEACHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum HeadmasterStatus {
  ACTIVE
  INACTIVE
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum SessionStatus {
  ACTIVE
  CLOSED
}

enum TermStatus {
  ACTIVE
  CLOSED
}

enum ClassStatus {
  ACTIVE
  INACTIVE
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  WITHDRAWN
}

enum AssignmentContextStatus {
  ACTIVE
  INACTIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssignmentStatus {
  OPEN
  CLOSED
}

enum AssessmentType {
  QUIZ
  TEST
  CA
  EXAMINATION
}

enum FeeAccountStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
}

enum SchoolEventType {
  MEETING
  DEADLINE
  EXAM
  ACTIVITY
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  headmasters      Headmaster[]
  teachers         Teacher[]
  students         Student[]
  academicSessions AcademicSession[]
  classes          Class[]
  subjects         Subject[]
  grades           Grade[]
  periods          Period[]
  feeStructures    FeeStructure[]
  schoolEvents     SchoolEvent[]
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  roleId       String     @db.Uuid
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  role       Role        @relation(fields: [roleId], references: [id])
  headmaster Headmaster?
  teacher    Teacher?
  payments   Payment[]

  @@index([roleId])
}

model Headmaster {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @db.Uuid
  userId         String?          @unique @db.Uuid
  firstName      String
  lastName       String
  email          String
  phone          String?
  staffNumber    String
  dateOfBirth    DateTime         @db.Date
  address        String?
  employmentDate DateTime         @db.Date
  status         HeadmasterStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([schoolId])
}

model Teacher {
  id             String        @id @default(uuid()) @db.Uuid
  schoolId       String        @db.Uuid
  userId         String?       @unique @db.Uuid
  firstName      String
  lastName       String
  email          String
  phone          String?
  staffNumber    String
  dateOfBirth    DateTime      @db.Date
  address        String?
  employmentDate DateTime      @db.Date
  qualification  String?
  status         TeacherStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  teachingAssignments TeachingAssignment[]
  attendance           Attendance[]

  @@unique([schoolId, staffNumber])
  @@index([schoolId])
}

model Student {
  id              String        @id @default(uuid()) @db.Uuid
  schoolId        String        @db.Uuid
  firstName       String
  lastName        String
  admissionNumber String
  dateOfBirth     DateTime      @db.Date
  gender          Gender
  address         String?
  admissionDate   DateTime      @db.Date
  status          StudentStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  enrollments Enrollment[]
  attendance Attendance[]
  scores      Score[]
  feeAccounts StudentFeeAccount[]
  submissions Submission[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
}

model AcademicSession {
  id        String        @id @default(uuid()) @db.Uuid
  schoolId  String        @db.Uuid
  name      String
  startDate DateTime      @db.Date
  endDate   DateTime      @db.Date
  status    SessionStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  terms  Term[]

  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]

  feeStructures FeeStructure[]

  @@index([schoolId])
}

model Term {
  id                String     @id @default(uuid()) @db.Uuid
  academicSessionId String     @db.Uuid
  name              String
  startDate         DateTime   @db.Date
  endDate           DateTime   @db.Date
  status            TermStatus @default(ACTIVE)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  teachingAssignments TeachingAssignment[]
  attendance           Attendance[]
  assessments          Assessment[]

  @@index([academicSessionId])
}

model Class {
  id        String      @id @default(uuid()) @db.Uuid
  schoolId  String      @db.Uuid
  name      String
  level     String
  capacity  Int
  status    ClassStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  enrollments  Enrollment[]
  classSubjects ClassSubject[]
  timetableEntries TimetableEntry[]
  attendance       Attendance[]

  @@index([schoolId])
}

model Subject {
  id          String        @id @default(uuid()) @db.Uuid
  schoolId    String        @db.Uuid
  name        String
  code        String
  description String?
  status      SubjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  classSubjects ClassSubject[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Grade {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  minScore  Decimal  @db.Decimal(5, 2)
  maxScore  Decimal  @db.Decimal(5, 2)
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  scores Score[]

  @@index([schoolId])
}

model Enrollment {
  id                String           @id @default(uuid()) @db.Uuid
  studentId         String           @db.Uuid
  classId           String           @db.Uuid
  academicSessionId String           @db.Uuid
  enrollmentDate    DateTime         @default(now()) @db.Date
  status            EnrollmentStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  student         Student         @relation(fields: [studentId], references: [id])
  class           Class           @relation(fields: [classId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])

  @@index([studentId, academicSessionId])
  @@index([classId])
}

model ClassSubject {
  id        String   @id @default(uuid()) @db.Uuid
  classId   String   @db.Uuid
  subjectId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class              Class               @relation(fields: [classId], references: [id])
  subject            Subject             @relation(fields: [subjectId], references: [id])
  teachingAssignments TeachingAssignment[]

  @@unique([classId, subjectId])
  @@index([subjectId])
}

model TeachingAssignment {
  id                String                  @id @default(uuid()) @db.Uuid
  teacherId         String                  @db.Uuid
  classSubjectId    String                  @db.Uuid
  academicSessionId String                  @db.Uuid
  termId            String                  @db.Uuid
  status            AssignmentContextStatus @default(ACTIVE)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  teacher         Teacher         @relation(fields: [teacherId], references: [id])
  classSubject    ClassSubject    @relation(fields: [classSubjectId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  term            Term            @relation(fields: [termId], references: [id])

  timetableEntries TimetableEntry[]
  assignments      Assignment[]
  assessments      Assessment[]

  @@unique([classSubjectId, termId])
  @@index([teacherId, academicSessionId, termId])
}

model Period {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  name      String
  startTime DateTime @db.Time(0)
  endTime   DateTime @db.Time(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  timetableEntries TimetableEntry[]

  @@index([schoolId])
}

model TimetableEntry {
  id                     String   @id @default(uuid()) @db.Uuid
  classId                String   @db.Uuid
  teachingAssignmentId   String   @db.Uuid
  periodId               String   @db.Uuid
  dayOfWeek              DayOfWeek
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  class               Class               @relation(fields: [classId], references: [id])
  teachingAssignment  TeachingAssignment  @relation(fields: [teachingAssignmentId], references: [id])
  period              Period              @relation(fields: [periodId], references: [id])

  @@index([classId, dayOfWeek])
  @@index([teachingAssignmentId])
  @@index([periodId])
}

model Attendance {
  id         String           @id @default(uuid()) @db.Uuid
  studentId  String           @db.Uuid
  classId    String           @db.Uuid
  termId     String           @db.Uuid
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  recordedBy String           @db.Uuid
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  student  Student  @relation(fields: [studentId], references: [id])
  class    Class    @relation(fields: [classId], references: [id])
  term     Term     @relation(fields: [termId], references: [id])
  recorder Teacher  @relation(fields: [recordedBy], references: [id])

  @@index([classId, termId, date])
  @@index([studentId])
  @@index([recordedBy])
}

model Assignment {
  id                     String           @id @default(uuid()) @db.Uuid
  teachingAssignmentId   String           @db.Uuid
  title                  String
  description            String?
  dueDate                DateTime
  status                 AssignmentStatus @default(OPEN)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])

  submissions Submission[]

  @@index([teachingAssignmentId])
}

model Assessment {
  id                   String         @id @default(uuid()) @db.Uuid
  teachingAssignmentId String         @db.Uuid
  termId               String         @db.Uuid
  name                 String
  type                 AssessmentType
  maxScore             Decimal        @db.Decimal(5, 2)
  date                 DateTime       @db.Date
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])
  term               Term               @relation(fields: [termId], references: [id])
  scores             Score[]

  @@index([teachingAssignmentId, termId])
}

model Score {
  id           String   @id @default(uuid()) @db.Uuid
  assessmentId String   @db.Uuid
  studentId    String   @db.Uuid
  gradeId      String?  @db.Uuid
  score        Decimal  @db.Decimal(5, 2)
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])
  grade      Grade?     @relation(fields: [gradeId], references: [id])

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model FeeStructure {
  id                String   @id @default(uuid()) @db.Uuid
  schoolId          String   @db.Uuid
  academicSessionId String   @db.Uuid
  name              String
  amount            Decimal  @db.Decimal(12, 2)
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school           School              @relation(fields: [schoolId], references: [id])
  academicSession  AcademicSession     @relation(fields: [academicSessionId], references: [id])
  studentFeeAccounts StudentFeeAccount[]

  @@index([schoolId])
}

model StudentFeeAccount {
  id             String          @id @default(uuid()) @db.Uuid
  studentId      String          @db.Uuid
  feeStructureId String          @db.Uuid
  amountDue      Decimal         @db.Decimal(12, 2)
  status         FeeAccountStatus @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  student      Student      @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  payments     Payment[]

  @@unique([studentId, feeStructureId])
  @@index([feeStructureId])
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  studentFeeAccountId  String        @db.Uuid
  amount               Decimal       @db.Decimal(12, 2)
  paymentDate          DateTime      @default(now()) @db.Date
  paymentMethod        PaymentMethod @default(CASH)
  reference            String        @unique
  status               PaymentStatus @default(CONFIRMED)
  recordedBy           String        @db.Uuid
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  studentFeeAccount StudentFeeAccount @relation(fields: [studentFeeAccountId], references: [id])
  recorder          User              @relation(fields: [recordedBy], references: [id])

  @@index([studentFeeAccountId])
}

model Submission {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @db.Uuid
  studentId    String           @db.Uuid
  submittedAt  DateTime         @default(now())
  status       SubmissionStatus @default(SUBMITTED)
  content      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model SchoolEvent {
  id          String          @id @default(uuid()) @db.Uuid
  schoolId    String          @db.Uuid
  title       String
  type        SchoolEventType @default(MEETING)
  date        DateTime        @db.Date
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, date])
}
