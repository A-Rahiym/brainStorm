{
  "openapi": "3.0.3",
  "info": {
    "title": "Brainstorm School Management System API",
    "version": "0.2.0",
    "description": "School Management System API. Implemented endpoints: Authentication, People (Headmaster, Teacher, Student). See the guide/ docs for the full planned surface."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local development"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentication and session management"
    },
    {
      "name": "Headmasters",
      "description": "School headmaster management"
    },
    {
      "name": "Teachers",
      "description": "Teacher management"
    },
    {
      "name": "Students",
      "description": "Student management"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in with email and password",
        "description": "Validates credentials and sets an HttpOnly `brainstorm_session` cookie on the response.",
        "security": [],
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful; session cookie set",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly session cookie `brainstorm_session`",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log out and clear the session cookie",
        "security": [],
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Session cookie cleared",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get the current session",
        "description": "Returns whether a valid `brainstorm_session` cookie is present and, if so, the session payload.",
        "security": [],
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "Session state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/headmasters/{id}": {
      "get": {
        "tags": ["Headmasters"],
        "summary": "Get a headmaster",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "operationId": "getHeadmaster",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Headmaster",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeadmasterResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": ["Headmasters"],
        "summary": "Update a headmaster",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "operationId": "updateHeadmaster",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdParam"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateHeadmasterRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated headmaster",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeadmasterResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/teachers": {
      "post": {
        "tags": ["Teachers"],
        "summary": "Create a teacher",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "operationId": "createTeacher",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTeacherRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Teacher created",
            "content": {
              "application/json": {
